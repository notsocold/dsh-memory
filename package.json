{
  "name": "@local/dsh-memory",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent long-term memory for DeepSeek Harness: AI-judged memory topics saved while you chat, recalled in later sessions, and managed from a settings page.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CONTRACT.md",
    "docs/DESIGN.md",
    "docs/harness-client.patch"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js client.js lib/*.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT"
}
